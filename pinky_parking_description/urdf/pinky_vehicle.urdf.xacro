<?xml version="1.0"?>
<!--
  Pinky Pro 차량: 공식 로봇 모델(pinky_description) + 뒤에 붙인 고정형 트레일러.

  trailer_length 가 0 이면 공식 robot.urdf.xacro 와 같다. 트레일러는 차체 뒤끝(x = -0.075 m,
  base_footprint 기준)에 붙은 상자이고, 윗면을 LiDAR 스캔 높이(약 0.125 m)보다 낮게 두어
  LiDAR 가 자기 트레일러를 보지 않는다. 바닥에서는 떠 있다(바퀴 없음, 무게는 차체가 받침).
  치수는 config/vehicles.yaml 의 차종에서 정한다.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="pinky">
    <xacro:include filename="$(find pinky_description)/urdf/pinky.urdf.xacro"/>

    <xacro:arg name="namespace" default=""/>
    <xacro:arg name="is_sim" default="false"/>
    <xacro:arg name="cam_tilt_deg" default="8"/>
    <xacro:arg name="screen_tilt_deg" default="-25"/>
    <xacro:arg name="trailer_length" default="0.0"/>
    <xacro:arg name="trailer_width" default="0.10"/>
    <xacro:arg name="trailer_top" default="0.06"/>
    <xacro:arg name="trailer_clearance" default="0.01"/>
    <xacro:arg name="trailer_mass" default="0.05"/>

    <xacro:insert_robot namespace="$(arg namespace)"
                        is_sim="$(arg is_sim)"
                        cam_tilt_deg="$(arg cam_tilt_deg)"
                        screen_tilt_deg="$(arg screen_tilt_deg)"/>

    <xacro:property name="length" value="$(arg trailer_length)"/>
    <xacro:property name="width" value="$(arg trailer_width)"/>
    <xacro:property name="height" value="${$(arg trailer_top) - $(arg trailer_clearance)}"/>
    <xacro:property name="mass" value="$(arg trailer_mass)"/>
    <xacro:property name="body_rear" value="-0.075"/>
    <xacro:property name="base_link_z" value="0.028"/>

    <xacro:if value="${length > 0}">
        <link name="trailer_link">
            <visual>
                <geometry><box size="${length} ${width} ${height}"/></geometry>
                <material name="trailer_orange"><color rgba="0.95 0.55 0.1 1"/></material>
            </visual>
            <collision>
                <geometry><box size="${length} ${width} ${height}"/></geometry>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <inertia ixx="${mass * (width * width + height * height) / 12}" ixy="0" ixz="0"
                         iyy="${mass * (length * length + height * height) / 12}" iyz="0"
                         izz="${mass * (length * length + width * width) / 12}"/>
            </inertial>
        </link>
        <joint name="$(arg namespace)trailer_fixed_joint" type="fixed">
            <parent link="base_link"/>
            <child link="trailer_link"/>
            <origin xyz="${body_rear - length / 2} 0 ${$(arg trailer_clearance) + height / 2 - base_link_z}"
                    rpy="0 0 0"/>
        </joint>
    </xacro:if>
</robot>
